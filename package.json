{
  "name": "@cagrmeister/design",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cagr-design-check": "bin/design-check.mjs",
    "cagr-design-codemod": "bin/design-codemod.mjs"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./theme": { "types": "./dist/theme.d.ts", "default": "./dist/theme.js" },
    "./tokens": { "types": "./dist/tokens.d.ts", "default": "./dist/tokens.js" },
    "./theme.css": "./dist/css/theme.css",
    "./strict.css": "./dist/css/strict.css",
    "./compat.css": "./dist/css/compat.css",
    "./fonts.css": "./dist/css/fonts.css",
    "./components.css": "./dist/css/components.css",
    "./table.css": "./dist/css/table.css",
    "./package.json": "./package.json"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist", "bin", "DESIGN.md", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
